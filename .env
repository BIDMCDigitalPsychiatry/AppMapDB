# Public build-time configuration (compiled into the JS bundle — no secrets).
#
# Authenticated write API (cloud_functions/mindapps-write-api). When set,
# signed-in writes flow through the Lambda with server-side role enforcement;
# unset it to revert to legacy direct DynamoDB writes (instant rollback).
REACT_APP_WRITE_API_URL=https://c9f9mkxos6.execute-api.us-east-1.amazonaws.com
